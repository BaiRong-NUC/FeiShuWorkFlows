FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your_app_secret
# 推荐：填写文件链接，多个文件用英文逗号分隔；自动识别 wiki / sheets / base 并读取全部工作表
FEISHU_LEDGER_URLS=
# 多表聊天建档：可以留空，由消息中的产品名称或“台账：工作表名称”选择；不会任意写第一张表
SPEAKER_CHAT_TARGET=
# 普通电子表格使用稳定 ID 定位行；专用备注不覆盖人工的“处理备注”
FEISHU_SHEETS_ID_FIELD=ID
FEISHU_SHEETS_NOTE_FIELD=Agent备注
# 可选：不填则只回复来源会话或提出人
FEISHU_NOTIFY_CHAT_ID=
FEISHU_BOT_OPEN_ID=
FEISHU_DOC_FOLDER_TOKEN=
FEISHU_CREATE_DOCUMENTS=false

FEISHU_TRIGGER_STATUS=待生成方案
FEISHU_PROCESSING_STATUS=生成中
FEISHU_COMPLETED_STATUS=已生成
FEISHU_FAILED_STATUS=生成失败

FEISHU_STATUS_FIELD=状态
# 可选：配置状态列 ID 可提前过滤无关事件；不填则读取完整记录核对
FEISHU_STATUS_FIELD_ID=
FEISHU_TITLE_FIELD=需求标题
FEISHU_REQUESTER_FIELD=提出人
FEISHU_PROPOSAL_FIELD=方案链接
FEISHU_ERROR_FIELD=处理备注
FEISHU_RAW_FIELD=需求原文
FEISHU_RESULT_FIELD=处理结论
SPEAKER_REPLY_TEMPLATE=agents/speaker_agent/templates/reply.md

# 聊天需求理解：deepseek 使用大模型；rules 为显式选择的本地规则模式
SPEAKER_INTAKE_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_TOKENS=4096
SPEAKER_INTAKE_MAX_CHARS=12000
# 新增一个多行文本列，保存大模型整理后的需求单；需求原文仍完整保留
FEISHU_BRIEF_FIELD=需求单

FEISHU_ENABLE_POLLING=true
FEISHU_POLL_SECONDS=300
FEISHU_ENABLE_CHAT_COMMANDS=true
FEISHU_RUNTIME_DIR=runtime
FEISHU_LOG_LEVEL=INFO
